# ==============================================================================
# Norwegian Company Intelligence Agent - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Google Gemini Intelligence Model
# ------------------------------------------------------------------------------
# API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=
# Configurable model names (low-cost model by default)
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-2.0-flash

# ------------------------------------------------------------------------------
# Browser Automation Providers
# ------------------------------------------------------------------------------
# Options: 'browser_use', 'tinyfish', 'http', 'mock'
BROWSER_PROVIDER=mock

# TinyFish Agent API Key (https://agent.tinyfish.ai/api-keys)
TINYFISH_API_KEY=

# Headless mode for Browser Use (set to false for local visual debugging)
BROWSER_USE_HEADLESS=true

# ------------------------------------------------------------------------------
# Database & Storage
# ------------------------------------------------------------------------------
# Default SQLite storage; change to postgresql+psycopg2://user:pass@host/db for Postgres
DATABASE_URL=sqlite:///./data/company_agent.db

# ------------------------------------------------------------------------------
# Resource Budgets & Hard Execution Limits
# ------------------------------------------------------------------------------
# Hard limit of 2,000 outbound requests per daily evaluation
MAX_DAILY_REQUESTS=2000

# Hard limit of $10.00 declared external API cost per daily evaluation
MAX_DAILY_COST_USD=10.0

# Internal cost ceiling for safety margin (stops nonessential requests early)
INTERNAL_COST_CEILING_USD=8.0

# Maximum execution time in seconds (45 minutes = 2700 seconds)
MAX_RUN_TIME_SECONDS=2700

# Maximum token budget per company profile extraction
MAX_TOKEN_BUDGET_PER_COMPANY=3000

# Maximum evidence snippets passed to Gemini per call
MAX_SNIPPETS_PER_MODEL_CALL=5

# ------------------------------------------------------------------------------
# Profile Freshness Intervals (in days)
# ------------------------------------------------------------------------------
# Stable identity facts (Legal form, registration date, etc.)
IDENTITY_FRESHNESS_DAYS=30

# Rapidly changing / dynamic facts (Employees, annual accounts, website)
DYNAMIC_FRESHNESS_DAYS=7

# ------------------------------------------------------------------------------
# Public Registries & Outbound HTTP
# ------------------------------------------------------------------------------
BRREG_API_BASE=https://data.brreg.no/enhetsregisteret/api
BRREG_REGNSKAP_BASE=https://data.brreg.no/regnskapsregisteret
HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_RETRIES=3
USER_AGENT=NorwegianCompanyIntelligenceAgent/1.0 (+https://github.com/karthik-ak-Git/nano-research; evaluation-bot)

# ------------------------------------------------------------------------------
# Execution Flags & Logging
# ------------------------------------------------------------------------------
DRY_RUN=false
LOG_LEVEL=INFO
